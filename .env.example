# --- Telegram bot (Stage 1) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
BOT_ACCESS_PASSWORD=choose-a-password
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# --- Weekly AI recommendations + email (Stage 3) ---
# Only needed to run weekly_recommendations.py locally. In GitHub Actions these
# come from repo secrets instead (see .github/workflows/weekly_recommendations.yml)
# and FIREBASE_SERVICE_ACCOUNT_JSON (the whole key file, one line) is used there
# instead of FIREBASE_SERVICE_ACCOUNT_PATH.
GROQ_API_KEY=your-groq-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=you@example.com
