rules_version = '2';

// This app has two writers: the Telegram bot (Firebase Admin SDK — bypasses
// these rules entirely) and the website (Firebase Auth + client SDK — bound
// by these rules). The website is READ-ONLY: all portfolio writes happen
// through the bot, so these rules never need to trust arbitrary client input
// for financial data, only for the account-linking handshake below.
service cloud.firestore {
  match /databases/{database}/documents {

    // One-time codes the bot generates via /link. High-entropy random IDs
    // (see connect_firebase.create_link_code) make guessing infeasible, so a
    // direct-ID "get" is safe to allow; listing/querying all codes is not.
    match /link_codes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if false; // only the bot (Admin SDK) creates these
    }

    // Proves a signed-in web user controls a given Telegram account: the
    // client submits the code it read from link_codes, and the write is only
    // accepted if telegram_id/expiry match what's actually stored there.
    match /account_links/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.telegram_id ==
             get(/databases/$(database)/documents/link_codes/$(request.resource.data.used_code)).data.telegram_id
        && get(/databases/$(database)/documents/link_codes/$(request.resource.data.used_code)).data.expires_at > request.time;
      allow update, delete: if false; // a link, once made, can't be reassigned from the client
    }

    // Portfolio data. Read-only from the web, and only for the Telegram
    // account this signed-in user has linked to.
    match /users/{telegramId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/account_links/$(request.auth.uid))
        && get(/databases/$(database)/documents/account_links/$(request.auth.uid)).data.telegram_id == telegramId;
      allow write: if false; // bot only, via the Admin SDK

      match /transactions/{transactionId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/account_links/$(request.auth.uid))
          && get(/databases/$(database)/documents/account_links/$(request.auth.uid)).data.telegram_id == telegramId;
        allow write: if false;
      }

      // The website has no backend of its own, so an AI question is relayed
      // through Firestore: the site creates a "pending" request here, and the
      // already-running Telegram bot (Admin SDK, bypasses these rules) picks
      // it up, computes an answer, and writes status "answered" + the answer
      // back. The client can create its own request and read it (to see the
      // answer land), but can never write the answer itself.
      match /ai_requests/{requestId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/account_links/$(request.auth.uid))
          && get(/databases/$(database)/documents/account_links/$(request.auth.uid)).data.telegram_id == telegramId;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/account_links/$(request.auth.uid))
          && get(/databases/$(database)/documents/account_links/$(request.auth.uid)).data.telegram_id == telegramId
          && request.resource.data.status == "pending"
          && request.resource.data.question is string
          && request.resource.data.question.size() > 0
          && request.resource.data.question.size() < 500;
        allow update, delete: if false; // only the bot (Admin SDK) writes the answer
      }
    }
  }
}
